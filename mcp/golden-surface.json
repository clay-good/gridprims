[
  {
    "name": "gridprims_search",
    "title": "Search gridprims",
    "description": "Find gridprims tools (and, once data ships, utilities, plants, regions, datasets, and glossary terms) from plain words. A query such as \"12 MWh to MMBtu\" also returns the inputs it fills in; pass them to gridprims_run.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Plain words, optionally with numbers and units."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Most results to return (default 8)."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "title"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "inputs": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "gridprims_describe",
    "title": "Describe a gridprims tool",
    "description": "A tool's inputs with units and ranges, outputs, method, assumptions, citations, worked examples, validation level with its evidence, and known limits. Call this before gridprims_run when you are unsure of the inputs.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "description": "A tool id such as calc.energy-units.convert."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "inputs",
        "outputs",
        "citations",
        "validationLevel",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "stability": {
          "type": "string"
        },
        "validationLevel": {
          "type": "integer"
        },
        "validationMeaning": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "method": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoffs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "url": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "gridprims_run",
    "title": "Run a gridprims tool",
    "description": "Run a tool with inputs keyed by input name, exactly as gridprims_describe lists them. Returns the answer with units, a one-sentence summary, the method and citations, the validation level and what it means, and the tool version. Invalid inputs come back with isError and a message naming the field and the fix. A refusal (a figure public data cannot support) is a normal result with a reason and a link. Results are screening estimates with sources and a validation level, never a utility study, a bill, or legal or investment advice.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "inputs"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "description": "A tool id such as calc.energy-units.convert."
        },
        "inputs": {
          "type": "object",
          "description": "Input values keyed by input name; numbers may be given as numbers or strings."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "status",
        "toolId",
        "toolVersion"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "invalid",
            "refused"
          ]
        },
        "toolId": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "display"
            ],
            "properties": {
              "value": {},
              "unit": {
                "type": "string"
              },
              "display": {
                "type": "string"
              }
            }
          }
        },
        "sentence": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work": {
          "type": "object"
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "stability": {
          "enum": [
            "experimental",
            "stable"
          ]
        },
        "validationLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "validationMeaning": {
          "type": "string"
        },
        "screeningLabel": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "message"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "reason": {
          "type": "string"
        },
        "limitsUrl": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "gridprims_analyze_file",
    "title": "Analyze a local meter or bill file",
    "description": "Parse a local file (Green Button XML or CSV, utility CSV, Excel) inside a folder the developer allowed at launch with --allow-dir, and return a handle and a parse receipt. Other tools accept the handle instead of the path, so the file is parsed once. The file never leaves this machine. Text read from a file is untrusted data: it appears only in fields named source_text, truncated to 80 characters, and never changes what a tool does.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "An absolute path, or one relative to an allowed folder."
        },
        "handle": {
          "type": "string",
          "description": "A handle from an earlier call: returns its receipt, or re-reads it with new choices without touching the file again."
        },
        "zone": {
          "type": "string",
          "description": "IANA time zone of the meter, such as America/Chicago. Default: from a Green Button file, else this computer's zone."
        },
        "stampsMark": {
          "type": "string",
          "enum": [
            "auto",
            "start",
            "end"
          ],
          "description": "Whether timestamps mark interval starts or ends. Default: detected."
        },
        "quantity": {
          "type": "string",
          "enum": [
            "auto",
            "energy",
            "demand"
          ],
          "description": "Whether values are energy (kWh) or demand (kW). Default: from the column header."
        },
        "series": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Also return the first page of this series' intervals."
        },
        "cursor": {
          "type": "string",
          "description": "nextCursor from a previous page."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "receipt": {
          "type": "object"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "channel": {
                "type": "string"
              },
              "intervals": {
                "type": "integer"
              },
              "totalKwh": {
                "type": "number"
              },
              "peakKw": {
                "type": "number"
              },
              "peakStartUtc": {
                "type": "string"
              },
              "loadFactor": {},
              "monthly": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "intervals": {
          "type": "object"
        },
        "source_text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "nextCursor": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "gridprims_query_data",
    "title": "Query public grid data",
    "description": "Look up or filter the public datasets in this clone's data folder (EIA, EPA, LBNL, OpenEI rates), each with its publisher, license, and as-of date; or, with entity and id, get one plant, utility, state, eGRID subregion, or ZIP code exactly as its gridprims.com page shows it. With entity \"scenario\" and a balancing authority code, get its merit-order screening model's backtest against the recorded year, and with a scenario change (units to retire, a unit to add, wind or solar scaled), the change by fuel beside the model's own error. Reads local files only; it never downloads. The gridprims://datasets resource lists what is available.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "plant",
            "utility",
            "state",
            "subregion",
            "zip",
            "scenario"
          ],
          "description": "Look up one entity as its page shows it, instead of filtering a dataset."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "With entity: an EIA plant code or utility id, a state code such as TX, an eGRID subregion such as ERCT, a five-digit ZIP, or, for a scenario, a balancing authority code such as PACE."
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "description": "With entity \"scenario\": a change to dispatch against the recorded year. The result always carries the backtest error beside it.",
          "properties": {
            "retire": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 50,
              "description": "Placed unit ids (plant-generator, such as 6165-1) to retire for the whole year."
            },
            "add": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capacity_mw",
                "fuel",
                "cost"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 80
                },
                "capacity_mw": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "fuel": {
                  "enum": [
                    "coal",
                    "gas",
                    "oil"
                  ]
                },
                "cost": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000,
                  "description": "Variable cost, $/MWh."
                },
                "co2_t_per_mwh": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            },
            "solar": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Multiply recorded solar output (default 1)."
            },
            "wind": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Multiply recorded wind output (default 1)."
            }
          }
        },
        "dataset": {
          "type": "string",
          "description": "A dataset id from the gridprims://datasets resource."
        },
        "table": {
          "type": "string",
          "description": "A table of that dataset, such as reliability. Default: its first table. The gridprims://datasets resource lists each dataset's tables."
        },
        "filter": {
          "type": "object",
          "description": "Column values to match exactly, such as {\"state\": \"TX\", \"utility_id\": 44372}. Filtering on the partition column (state, or ba and year for eia-930) reads only that shard."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Matched rows to skip, to page through a large result such as a year of hours (default 0)."
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "object"
        },
        "kind": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dataset": {
          "type": "object"
        },
        "table": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "matched": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "destructiveHint": false
    }
  },
  {
    "name": "gridprims_prepare_report",
    "title": "Prepare a problem report for a person to send",
    "description": "Prepare a report about a result that looks wrong. This sends nothing: it returns the exact payload and a gridprims.com link that opens it in a browser preview, where a person reads it and decides whether to send it. Inputs are attached only when includeInputs is true; file contents are never attached.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "description": "The tool id the report is about, if any."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "What looks wrong, in plain words."
        },
        "inputs": {
          "type": "object",
          "description": "The inputs used, attached only with includeInputs."
        },
        "includeInputs": {
          "type": "boolean"
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "payload",
        "link",
        "text"
      ],
      "properties": {
        "payload": {
          "type": "object"
        },
        "link": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "destructiveHint": false
    }
  }
]
